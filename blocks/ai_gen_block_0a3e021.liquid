{% doc %}
  @prompt
    Create a product page layout with three columns: left column shows the product title in bold uppercase, sale price in red with strikethrough compare-at price, short description text, and accordion/expandable tabs for Size Chart, Shipping, and Return and Exchange. Centre column shows a large product image. Right column shows size variant selector buttons (S, M, L, XL, 2XL) and a bold black Add to Cart button with price. Clean minimal white background, no clutter, streetwear aesthetic.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign size_values = 'S,M,L,XL,2XL' | split: ',' %}
{% style %}
.ai-product-layout-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }};font-family:{{ settings.type_body_font.family }},sans-serif}.ai-product-layout-{{ ai_gen_id }}__grid{display:grid;grid-template-columns:minmax(180px,.8fr) minmax(280px,1.6fr) minmax(180px,.8fr);gap:{{ block.settings.column_gap }}px;align-items:start;padding:{{ block.settings.vertical_padding }}px 0}.ai-product-layout-{{ ai_gen_id }}__title{margin:0 0 18px;color:{{ block.settings.heading_color }};font-family:{{ settings.type_header_font.family }},sans-serif;font-size:{{ block.settings.title_size }}px;line-height:.98;letter-spacing:-.03em;text-transform:uppercase;font-weight:900}.ai-product-layout-{{ ai_gen_id }}__prices{display:flex;gap:10px;align-items:baseline;margin-bottom:20px;flex-wrap:wrap}.ai-product-layout-{{ ai_gen_id }}__price{color:{{ block.settings.sale_color }};font-size:21px;font-weight:700}.ai-product-layout-{{ ai_gen_id }}__compare{color:{{ block.settings.muted_color }};font-size:14px;text-decoration:line-through}.ai-product-layout-{{ ai_gen_id }}__description{font-size:{{ settings.product_desc_size_pc }}px;line-height:{{ settings.product_desc_line_height_pc }};margin-bottom:28px}.ai-product-layout-{{ ai_gen_id }}__description p{margin:0 0 10px}.ai-product-layout-{{ ai_gen_id }}__media{background:#f7f7f7}.ai-product-layout-{{ ai_gen_id }}__media img,.ai-product-layout-{{ ai_gen_id }}__placeholder svg{display:block;width:100%;height:auto;aspect-ratio:1/1.2;object-fit:cover}.ai-product-layout-{{ ai_gen_id }}__placeholder{position:relative}.ai-product-layout-{{ ai_gen_id }}__empty{position:absolute;bottom:14px;left:0;width:100%;text-align:center;color:#666;font-size:12px}.ai-product-layout-{{ ai_gen_id }}__option-label{display:block;margin:0 0 12px;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.ai-product-layout-{{ ai_gen_id }}__sizes{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:28px}.ai-product-layout-{{ ai_gen_id }}__size{min-width:45px;padding:12px 10px;border:1px solid {{ block.settings.border_color }};background:#fff;color:#000;font-weight:700;cursor:pointer}.ai-product-layout-{{ ai_gen_id }}__size[aria-pressed=true]{background:#000;color:#fff;border-color:#000}.ai-product-layout-{{ ai_gen_id }}__size:focus-visible,.ai-product-layout-{{ ai_gen_id }}__submit:focus-visible,.ai-product-layout-{{ ai_gen_id }}__summary:focus-visible{outline:3px solid {{ block.settings.focus_color }};outline-offset:3px}.ai-product-layout-{{ ai_gen_id }}__submit{display:flex;justify-content:space-between;width:100%;padding:16px;border:0;background:{{ block.settings.button_color }};color:{{ block.settings.button_text_color }};font-weight:800;text-transform:uppercase;cursor:pointer}.ai-product-layout-{{ ai_gen_id }}__submit:disabled{opacity:.5;cursor:not-allowed}.ai-product-layout-{{ ai_gen_id }}__accordion{border-top:1px solid {{ block.settings.border_color }}}.ai-product-layout-{{ ai_gen_id }}__summary{display:flex;justify-content:space-between;padding:15px 0;cursor:pointer;list-style:none;font-size:12px;font-weight:700;text-transform:uppercase}.ai-product-layout-{{ ai_gen_id }}__summary::-webkit-details-marker{display:none}.ai-product-layout-{{ ai_gen_id }}__content{padding:0 0 16px;font-size:13px;line-height:1.5}@media screen and (max-width:749px){.ai-product-layout-{{ ai_gen_id }}__grid{grid-template-columns:1fr;gap:24px;padding:{{ block.settings.mobile_padding }}px 0}.ai-product-layout-{{ ai_gen_id }}__media{grid-row:1}.ai-product-layout-{{ ai_gen_id }}__info{grid-row:2}.ai-product-layout-{{ ai_gen_id }}__purchase{grid-row:3}.ai-product-layout-{{ ai_gen_id }}__description{font-size:{{ settings.product_desc_size_mobile }}px;line-height:{{ settings.product_desc_line_height_mobile }}}}
{% endstyle %}
<product-layout-{{ ai_gen_id }} class="ai-product-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-product-layout-{{ ai_gen_id }}__grid"><div class="ai-product-layout-{{ ai_gen_id }}__info"><h1 class="ai-product-layout-{{ ai_gen_id }}__title">{{ product.title | escape }}</h1><div class="ai-product-layout-{{ ai_gen_id }}__prices"><span class="ai-product-layout-{{ ai_gen_id }}__price" data-price>{{ product.selected_or_first_available_variant.price | money }}</span>{% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}<span class="ai-product-layout-{{ ai_gen_id }}__compare">{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>{% endif %}</div><div class="ai-product-layout-{{ ai_gen_id }}__description">{{ product.description | strip_html | truncate: 180 }}</div>{% assign tabs = 'Size chart|Shipping|Return and exchange' | split: '|' %}{% for tab in tabs %}<details class="ai-product-layout-{{ ai_gen_id }}__accordion"><summary class="ai-product-layout-{{ ai_gen_id }}__summary">{{ tab }}<span>+</span></summary><div class="ai-product-layout-{{ ai_gen_id }}__content">{% if tab == 'Size chart' %}{{ block.settings.size_chart }}{% elsif tab == 'Shipping' %}{{ block.settings.shipping_info }}{% else %}{{ block.settings.returns_info }}{% endif %}</div></details>{% endfor %}</div><div class="ai-product-layout-{{ ai_gen_id }}__media">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 1600 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">{% else %}<div class="ai-product-layout-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}<div class="ai-product-layout-{{ ai_gen_id }}__empty">Add a product image</div></div>{% endif %}</div><div class="ai-product-layout-{{ ai_gen_id }}__purchase">{% form 'product', product %}<label class="ai-product-layout-{{ ai_gen_id }}__option-label" for="ai-size-{{ ai_gen_id }}">Size</label><div class="ai-product-layout-{{ ai_gen_id }}__sizes" role="group" aria-label="Choose a size">{% for value in size_values %}<button type="button" class="ai-product-layout-{{ ai_gen_id }}__size" data-size="{{ value }}" aria-pressed="false">{{ value }}</button>{% endfor %}</div><select id="ai-size-{{ ai_gen_id }}" name="id" hidden>{% for variant in product.variants %}<option value="{{ variant.id }}" data-title="{{ variant.title | escape }}" data-price="{{ variant.price | money | escape }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>{{ variant.title }}</option>{% endfor %}</select><button class="ai-product-layout-{{ ai_gen_id }}__submit" type="submit" {% unless product.available %}disabled{% endunless %}><span>{% if product.available %}Add to cart{% else %}Sold out{% endif %}</span><span data-button-price>{{ product.selected_or_first_available_variant.price | money }}</span></button>{% endform %}</div></div></product-layout-{{ ai_gen_id }}>
<script>(function(){class ProductLayout{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.select=this.querySelector('select');this.buttons=this.querySelectorAll('[data-size]');this.price=this.querySelector('[data-price]');this.buttonPrice=this.querySelector('[data-button-price]');this.buttons.forEach(button=>button.addEventListener('click',()=>{const variant=[...this.select.options].find(option=>option.dataset.title.split(' / ').includes(button.dataset.size));if(variant){this.select.value=variant.value;this.buttons.forEach(item=>item.setAttribute('aria-pressed','false'));button.setAttribute('aria-pressed','true');this.price.textContent=variant.dataset.price;this.buttonPrice.textContent=variant.dataset.price}}))}}customElements.define('product-layout-{{ ai_gen_id }}',ProductLayout{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Three-column product","settings":[{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"column_gap","label":"Column gap","min":10,"max":80,"step":5,"unit":"px","default":30},{"type":"range","id":"vertical_padding","label":"Vertical padding","min":0,"max":80,"step":5,"unit":"px","default":30},{"type":"range","id":"mobile_padding","label":"Mobile padding","min":0,"max":50,"step":5,"unit":"px","default":15},{"type":"range","id":"title_size","label":"Title size","min":20,"max":60,"step":5,"unit":"px","default":35},{"type":"richtext","id":"size_chart","label":"Size chart","default":"<p>Check the product measurements before ordering.</p>"},{"type":"richtext","id":"shipping_info","label":"Shipping info","default":"<p>UK delivery details and dispatch times.</p>"},{"type":"richtext","id":"returns_info","label":"Returns info","default":"<p>See our returns policy for exchange details.</p>"},{"type":"color","id":"background_color","label":"Background","default":"#FFFFFF"},{"type":"color","id":"text_color","label":"Text","default":"#000000"},{"type":"color","id":"heading_color","label":"Headings","default":"#000000"},{"type":"color","id":"sale_color","label":"Sale price","default":"#D00000"},{"type":"color","id":"muted_color","label":"Muted text","default":"#555555"},{"type":"color","id":"border_color","label":"Borders","default":"#D9D9D9"},{"type":"color","id":"button_color","label":"Button","default":"#000000"},{"type":"color","id":"button_text_color","label":"Button text","default":"#FFFFFF"},{"type":"color","id":"focus_color","label":"Focus outline","default":"#005FCC"}],"presets":[{"name":"Three-column product"}],"tag":null,"class":"three-column-product"}{% endschema %}