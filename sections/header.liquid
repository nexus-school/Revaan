{% comment %}
  VYBE hero overlay header
  Transparent, overlays the top hero, scrolls away with the page.
{% endcomment %}

<style>
  /* Critical: do NOT position this wrapper.
     The actual header needs to position against the page, not this section. */
  #shopify-section-{{ section.id }} {
    position: static !important;
    height: 0 !important;
    min-height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: visible !important;
    background: transparent !important;
  }

  .vybe-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 9999;
    background: transparent;
    color: #ffffff;
  }

  .vybe-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 58px;
    padding: 0 10px;
  }

  .vybe-header__left,
  .vybe-header__right {
    display: flex;
    align-items: center;
  }

  .vybe-header__left {
    justify-content: flex-start;
  }

  .vybe-header__right {
    justify-content: flex-end;
    gap: 15px;
    white-space: nowrap;
  }

  .vybe-header__nav {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  /* Same typography for every header word, including VYBE */
  .vybe-header__nav a,
  .vybe-header__brand,
  .vybe-header__right a {
    font-family: var(--font-heading-family) !important;
    font-style: var(--font-heading-style) !important;
    font-weight: var(--font-heading-weight) !important;
    text-transform: uppercase !important;
    font-size: 16px !important;
    line-height: 1 !important;
    letter-spacing: 0 !important;
    color: inherit !important;
    text-decoration: none !important;
  }

  .vybe-header__brand {
    justify-self: center;
  }

  .vybe-header__burger {
    display: none;
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .vybe-header__mobile-menu {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .vybe-header__nav,
    .vybe-header__account {
      display: none;
    }

    .vybe-header__burger {
      display: block;
    }

    .vybe-header__inner {
      min-height: 56px;
      padding: 0 12px;
    }

    .vybe-header__mobile-menu.is-open {
      display: flex;
      position: fixed;
      inset: 0;
      z-index: 10000;
      background: #ffffff;
      color: #000000;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 24px;
    }

    .vybe-header__mobile-menu a {
      font-family: var(--font-heading-family) !important;
      font-style: var(--font-heading-style) !important;
      font-weight: var(--font-heading-weight) !important;
      text-transform: uppercase !important;
      color: #000000 !important;
      text-decoration: none !important;
      font-size: 24px !important;
    }
  }
</style>

<header class="vybe-header">
  <div class="vybe-header__inner">
    <div class="vybe-header__left">
      <button
        class="vybe-header__burger"
        id="VybeMenuButton-{{ section.id }}"
        type="button"
        aria-label="Menu"
        aria-expanded="false"
      >
        <svg width="45" height="41" viewBox="0 0 55 51" fill="none" aria-hidden="true">
          <line x1="8" y1="20" x2="48" y2="20" stroke="currentColor" stroke-width="2"/>
          <line x1="8" y1="28.6133" x2="48" y2="28.6133" stroke="currentColor" stroke-width="2"/>
        </svg>
      </button>

      <nav class="vybe-header__nav" aria-label="Main navigation">
        {% if section.settings.menu != blank %}
          {% for link in section.settings.menu.links %}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {% endfor %}
        {% else %}
          <a href="{{ routes.root_url }}">Home</a>
          <a href="/collections/all">Catalog</a>
          <a href="/pages/lookbook">Lookbook</a>
          <a href="/pages/about-us">About us</a>
          <a href="/pages/contact">Contact</a>
        {% endif %}
      </nav>
    </div>

    <a class="vybe-header__brand" href="{{ routes.root_url }}">VYBE</a>

    <div class="vybe-header__right">
      {% if shop.customer_accounts_enabled %}
        <a class="vybe-header__account" href="{{ routes.account_url }}">Account</a>
      {% endif %}
      <a href="{{ routes.cart_url }}">Cart (<span id="CartCount">{{ cart.item_count }}</span>)</a>
    </div>
  </div>
</header>

<div class="vybe-header__mobile-menu" id="VybeMobileMenu-{{ section.id }}">
  {% if section.settings.menu != blank %}
    {% for link in section.settings.menu.links %}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {% endfor %}
  {% endif %}

  {% if shop.customer_accounts_enabled %}
    <a href="{{ routes.account_url }}">Account</a>
  {% endif %}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var button = document.getElementById('VybeMenuButton-{{ section.id }}');
    var menu = document.getElementById('VybeMobileMenu-{{ section.id }}');

    if (!button || !menu) return;

    button.addEventListener('click', function () {
      var open = menu.classList.toggle('is-open');
      button.setAttribute('aria-expanded', open ? 'true' : 'false');
      document.body.style.overflow = open ? 'hidden' : '';
    });

    menu.querySelectorAll('a').forEach(function (link) {
      link.addEventListener('click', function () {
        menu.classList.remove('is-open');
        button.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      });
    });
  });
</script>

{% schema %}
{
  "name": "VYBE hero header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    }
  ]
}
{% endschema %}
