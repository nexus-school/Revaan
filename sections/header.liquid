{% comment %}
  Header inspired by the reference layout:
  - Desktop: navigation left, logo centred, account/cart right
  - Mobile: burger left, logo centred, cart right
  - Full-screen mobile menu
{% endcomment %}

<style>
  .reference-style-header {
    width: 100%;
    background: #ffffff;
    color: #000000;
    position: relative;
    z-index: 100;
  }

  .reference-style-header * {
    box-sizing: border-box;
  }

  .reference-style-header__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 78px;
    padding: 0 22px;
  }

  .reference-style-header__left,
  .reference-style-header__right {
    display: flex;
    align-items: center;
  }

  .reference-style-header__left {
    justify-content: flex-start;
  }

  .reference-style-header__right {
    justify-content: flex-end;
    gap: 16px;
    white-space: nowrap;
  }

  .reference-style-header__nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }

  .reference-style-header__link,
  .reference-style-header__utility-link,
  .reference-style-header__mobile-link {
    color: #000000;
    text-decoration: none;
    text-transform: uppercase;
    font-family: var(--font-heading-family, Arial, sans-serif);
    font-size: 15px;
    line-height: 1;
  }

  .reference-style-header__link:hover,
  .reference-style-header__utility-link:hover,
  .reference-style-header__mobile-link:hover {
    opacity: 0.65;
  }

  .reference-style-header__logo {
    justify-self: center;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .reference-style-header__logo-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #000000;
    text-decoration: none;
  }

  .reference-style-header__logo-image {
    display: block;
    width: auto;
    max-width: 100%;
    height: {{ section.settings.logo_height }}px;
    object-fit: contain;
  }

  .reference-style-header__logo-text {
    font-family: var(--font-heading-family, Arial, sans-serif);
    font-size: 22px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .reference-style-header__burger {
    display: none;
    width: 45px;
    height: 41px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    position: relative;
    z-index: 1002;
  }

  .reference-style-header__burger svg {
    display: block;
  }

  .reference-style-header__burger .icon-close {
    display: none;
  }

  .reference-style-header__burger.is-open .icon-menu {
    display: none;
  }

  .reference-style-header__burger.is-open .icon-close {
    display: block;
  }

  .reference-style-header__mobile-menu {
    display: none;
  }

  .reference-style-header__cart-count {
    display: inline;
  }

  @media screen and (max-width: 749px) {
    .reference-style-header__inner {
      min-height: 70px;
      padding: 0 16px;
      grid-template-columns: 1fr auto 1fr;
    }

    .reference-style-header__desktop-nav,
    .reference-style-header__account-desktop {
      display: none;
    }

    .reference-style-header__burger {
      display: block;
    }

    .reference-style-header__logo-image {
      height: {{ section.settings.logo_height_mobile }}px;
    }

    .reference-style-header__utility-link {
      font-size: 14px;
    }

    .reference-style-header__mobile-menu {
      display: none;
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100dvh;
      background: #ffffff;
      z-index: 1000;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      padding: 90px 24px 40px;
      overflow-y: auto;
    }

    .reference-style-header__mobile-menu.is-open {
      display: flex;
    }

    .reference-style-header__mobile-nav {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 26px;
      width: 100%;
    }

    .reference-style-header__mobile-link {
      font-size: 24px;
      text-align: center;
    }

    .reference-style-header__mobile-account {
      margin-top: 26px;
    }
  }
</style>

<header class="reference-style-header" id="ReferenceHeader-{{ section.id }}">
  <div class="reference-style-header__inner">

    <div class="reference-style-header__left">
      <button
        type="button"
        class="reference-style-header__burger"
        id="ReferenceBurger-{{ section.id }}"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="ReferenceMobileMenu-{{ section.id }}"
      >
        <svg class="icon-menu" xmlns="http://www.w3.org/2000/svg" width="45" height="41" viewBox="0 0 55 51" fill="none" aria-hidden="true">
          <line x1="8" y1="20" x2="48" y2="20" stroke="currentColor" stroke-width="2"></line>
          <line x1="8" y1="28.6133" x2="48" y2="28.6133" stroke="currentColor" stroke-width="2"></line>
        </svg>

        <svg class="icon-close" xmlns="http://www.w3.org/2000/svg" width="45" height="41" viewBox="0 0 45 41" fill="none" aria-hidden="true">
          <path d="M13 30.4902L31.4902 12" stroke="currentColor" stroke-width="1.65"></path>
          <path d="M13 12L31.4902 30.4902" stroke="currentColor" stroke-width="1.65"></path>
        </svg>
      </button>

      <nav class="reference-style-header__nav reference-style-header__desktop-nav" aria-label="Main navigation">
        {% if section.settings.menu != blank %}
          {% for link in section.settings.menu.links %}
            <a class="reference-style-header__link" href="{{ link.url }}">
              {{ link.title }}
            </a>
          {% endfor %}
        {% else %}
          <a class="reference-style-header__link" href="{{ routes.root_url }}">Home</a>
          <a class="reference-style-header__link" href="/collections/all">Catalog</a>
          <a class="reference-style-header__link" href="/pages/about-us">About us</a>
          <a class="reference-style-header__link" href="/pages/contact">Contact</a>
        {% endif %}
      </nav>
    </div>

    <div class="reference-style-header__logo">
      <a class="reference-style-header__logo-link" href="{{ routes.root_url }}">
        {% if section.settings.logo != blank %}
          {{
            section.settings.logo
            | image_url: width: 500
            | image_tag:
              class: 'reference-style-header__logo-image',
              loading: 'eager',
              alt: shop.name
          }}
        {% else %}
          <span class="reference-style-header__logo-text">{{ shop.name }}</span>
        {% endif %}
      </a>
    </div>

    <div class="reference-style-header__right">
      {% if shop.customer_accounts_enabled %}
        <a class="reference-style-header__utility-link reference-style-header__account-desktop" href="{{ routes.account_url }}">
          Account
        </a>
      {% endif %}

      <a class="reference-style-header__utility-link" href="{{ routes.cart_url }}">
        Cart (<span class="reference-style-header__cart-count">{{ cart.item_count }}</span>)
      </a>
    </div>

  </div>
</header>

<div
  class="reference-style-header__mobile-menu"
  id="ReferenceMobileMenu-{{ section.id }}"
  aria-hidden="true"
>
  <nav class="reference-style-header__mobile-nav" aria-label="Mobile navigation">
    {% if section.settings.menu != blank %}
      {% for link in section.settings.menu.links %}
        <a class="reference-style-header__mobile-link" href="{{ link.url }}">
          {{ link.title }}
        </a>
      {% endfor %}
    {% else %}
      <a class="reference-style-header__mobile-link" href="{{ routes.root_url }}">Home</a>
      <a class="reference-style-header__mobile-link" href="/collections/all">Catalog</a>
      <a class="reference-style-header__mobile-link" href="/pages/about-us">About us</a>
      <a class="reference-style-header__mobile-link" href="/pages/contact">Contact</a>
    {% endif %}

    {% if shop.customer_accounts_enabled %}
      <a class="reference-style-header__mobile-link reference-style-header__mobile-account" href="{{ routes.account_url }}">
        Account
      </a>
    {% endif %}
  </nav>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var burger = document.getElementById('ReferenceBurger-{{ section.id }}');
    var menu = document.getElementById('ReferenceMobileMenu-{{ section.id }}');

    if (!burger || !menu) return;

    function setMenu(open) {
      burger.classList.toggle('is-open', open);
      menu.classList.toggle('is-open', open);
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
      burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.setAttribute('aria-hidden', open ? 'false' : 'true');
      document.body.style.overflow = open ? 'hidden' : '';
    }

    burger.addEventListener('click', function () {
      setMenu(!menu.classList.contains('is-open'));
    });

    menu.querySelectorAll('a').forEach(function (link) {
      link.addEventListener('click', function () {
        setMenu(false);
      });
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') {
        setMenu(false);
      }
    });
  });
</script>

{% schema %}
{
  "name": "Reference-style header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height - desktop",
      "min": 20,
      "max": 120,
      "step": 1,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "label": "Logo height - mobile",
      "min": 20,
      "max": 100,
      "step": 1,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    }
  ],
  "presets": [
    {
      "name": "Reference-style header"
    }
  ]
}
{% endschema %}
