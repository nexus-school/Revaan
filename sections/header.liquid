{% comment %}
  VYBE overlay header
  - Sits directly over the hero/image beneath it
  - Transparent at the top
  - VYBE uses the exact same typography as navigation/utility links
  - Desktop: menu left, VYBE centred, Account + Cart right
  - Mobile: burger left, VYBE centred, Cart right
{% endcomment %}

<style>
  /* Do not let the Shopify section wrapper create its own row above the hero */
  #shopify-section-{{ section.id }} {
    position: static !important;
    height: 0 !important;
    min-height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: visible !important;
    background: transparent !important;
  }

  .vybe-overlay-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 999;
    margin: 0;
    padding: 0;
    background: transparent;
    color: {{ section.settings.text_color }};
  }

  .vybe-overlay-header * {
    box-sizing: border-box;
  }

  .vybe-overlay-header__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: 100%;
    min-height: 58px;
    padding: 0 16px;
    margin: 0;
  }

  .vybe-overlay-header__left,
  .vybe-overlay-header__right {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .vybe-overlay-header__left {
    justify-content: flex-start;
  }

  .vybe-overlay-header__right {
    justify-content: flex-end;
    gap: 16px;
    white-space: nowrap;
  }

  .vybe-overlay-header__nav {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  /* EXACT same typography for menu, VYBE, Account and Cart */
  .vybe-overlay-header__nav-link,
  .vybe-overlay-header__wordmark,
  .vybe-overlay-header__utility-link,
  .vybe-overlay-header__mobile-link {
    font-family: var(--font-heading-family, Arial, Helvetica, sans-serif) !important;
    font-style: var(--font-heading-style, normal) !important;
    font-weight: var(--font-heading-weight, 700) !important;
    font-size: 15px !important;
    line-height: 1 !important;
    letter-spacing: 0 !important;
    text-transform: uppercase !important;
    color: inherit !important;
    text-decoration: none !important;
  }

  .vybe-overlay-header__nav-link:hover,
  .vybe-overlay-header__wordmark:hover,
  .vybe-overlay-header__utility-link:hover,
  .vybe-overlay-header__mobile-link:hover {
    opacity: 0.7;
  }

  .vybe-overlay-header__centre {
    justify-self: center;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .vybe-overlay-header__wordmark {
    display: inline-block;
    margin: 0;
    padding: 0;
  }

  .vybe-overlay-header__burger {
    display: none;
    width: 45px;
    height: 41px;
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    position: relative;
    z-index: 1002;
  }

  .vybe-overlay-header__burger svg {
    display: block;
  }

  .vybe-overlay-header__burger .icon-close {
    display: none;
  }

  .vybe-overlay-header__burger.is-open .icon-menu {
    display: none;
  }

  .vybe-overlay-header__burger.is-open .icon-close {
    display: block;
  }

  .vybe-overlay-header__mobile-menu {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .vybe-overlay-header__inner {
      min-height: 58px;
      padding: 0 8px;
    }
  }

  @media screen and (max-width: 749px) {
    .vybe-overlay-header__inner {
      min-height: 56px;
      padding: 0 12px;
    }

    .vybe-overlay-header__desktop-nav,
    .vybe-overlay-header__account-desktop {
      display: none;
    }

    .vybe-overlay-header__burger {
      display: block;
    }

    .vybe-overlay-header__mobile-menu {
      display: none;
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100dvh;
      background: {{ section.settings.mobile_menu_bg }};
      color: {{ section.settings.mobile_menu_text_color }};
      z-index: 1000;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      padding: 80px 24px 40px;
      overflow-y: auto;
    }

    .vybe-overlay-header__mobile-menu.is-open {
      display: flex;
    }

    .vybe-overlay-header__mobile-nav {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 26px;
      width: 100%;
    }

    .vybe-overlay-header__mobile-link {
      font-size: 24px !important;
      text-align: center;
    }

    .vybe-overlay-header__mobile-account {
      margin-top: 20px;
    }
  }
</style>

<header class="vybe-overlay-header" id="VybeHeader-{{ section.id }}">
  <div class="vybe-overlay-header__inner">

    <div class="vybe-overlay-header__left">
      <button
        type="button"
        class="vybe-overlay-header__burger"
        id="VybeBurger-{{ section.id }}"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="VybeMobileMenu-{{ section.id }}"
      >
        <svg class="icon-menu" xmlns="http://www.w3.org/2000/svg" width="45" height="41" viewBox="0 0 55 51" fill="none" aria-hidden="true">
          <line x1="8" y1="20" x2="48" y2="20" stroke="currentColor" stroke-width="2"></line>
          <line x1="8" y1="28.6133" x2="48" y2="28.6133" stroke="currentColor" stroke-width="2"></line>
        </svg>

        <svg class="icon-close" xmlns="http://www.w3.org/2000/svg" width="45" height="41" viewBox="0 0 45 41" fill="none" aria-hidden="true">
          <path d="M13 30.4902L31.4902 12" stroke="currentColor" stroke-width="1.65"></path>
          <path d="M13 12L31.4902 30.4902" stroke="currentColor" stroke-width="1.65"></path>
        </svg>
      </button>

      <nav class="vybe-overlay-header__nav vybe-overlay-header__desktop-nav" aria-label="Main navigation">
        {% if section.settings.menu != blank %}
          {% for link in section.settings.menu.links %}
            <a class="vybe-overlay-header__nav-link" href="{{ link.url }}">
              {{ link.title }}
            </a>
          {% endfor %}
        {% endif %}
      </nav>
    </div>

    <div class="vybe-overlay-header__centre">
      <a class="vybe-overlay-header__wordmark" href="{{ routes.root_url }}">VYBE</a>
    </div>

    <div class="vybe-overlay-header__right">
      {% if shop.customer_accounts_enabled %}
        <a
          class="vybe-overlay-header__utility-link vybe-overlay-header__account-desktop"
          href="{{ routes.account_url }}"
        >
          Account
        </a>
      {% endif %}

      <a class="vybe-overlay-header__utility-link" href="{{ routes.cart_url }}">
        Cart (<span>{{ cart.item_count }}</span>)
      </a>
    </div>

  </div>
</header>

<div
  class="vybe-overlay-header__mobile-menu"
  id="VybeMobileMenu-{{ section.id }}"
  aria-hidden="true"
>
  <nav class="vybe-overlay-header__mobile-nav" aria-label="Mobile navigation">
    {% if section.settings.menu != blank %}
      {% for link in section.settings.menu.links %}
        <a class="vybe-overlay-header__mobile-link" href="{{ link.url }}">
          {{ link.title }}
        </a>
      {% endfor %}
    {% endif %}

    {% if shop.customer_accounts_enabled %}
      <a
        class="vybe-overlay-header__mobile-link vybe-overlay-header__mobile-account"
        href="{{ routes.account_url }}"
      >
        Account
      </a>
    {% endif %}
  </nav>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var burger = document.getElementById('VybeBurger-{{ section.id }}');
    var menu = document.getElementById('VybeMobileMenu-{{ section.id }}');

    if (!burger || !menu) return;

    function setMenu(open) {
      burger.classList.toggle('is-open', open);
      menu.classList.toggle('is-open', open);
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
      burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.setAttribute('aria-hidden', open ? 'false' : 'true');
      document.body.style.overflow = open ? 'hidden' : '';
    }

    burger.addEventListener('click', function () {
      setMenu(!menu.classList.contains('is-open'));
    });

    menu.querySelectorAll('a').forEach(function (link) {
      link.addEventListener('click', function () {
        setMenu(false);
      });
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') setMenu(false);
    });
  });
</script>

{% schema %}
{
  "name": "VYBE overlay header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Header text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "mobile_menu_bg",
      "label": "Mobile menu background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "mobile_menu_text_color",
      "label": "Mobile menu text color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "VYBE overlay header"
    }
  ]
}
{% endschema %}
