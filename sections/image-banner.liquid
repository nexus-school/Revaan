<style>
  #shopify-section-header {
    margin: 0 !important;
    padding: 0 !important;
  }

  .header-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 58px;
    width: 100%;
    background: transparent;
  }

  .header-wrapper > * {
    flex: 1;
    text-align: center;
  }

  .header-menu {
    text-align: left;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
  }

  .header-menu .menu-item:not(:last-child) {
    margin-right: 15px;
  }

  .menu-item,
  .menu-item a,
  .right-nav,
  .right-nav > *,
  .header-logo-text {
    font-family: var(--font-heading-family) !important;
    font-style: var(--font-heading-style) !important;
    font-weight: var(--font-heading-weight) !important;
    font-size: 16px !important;
    line-height: 1 !important;
    letter-spacing: 0 !important;
    text-transform: uppercase !important;
    text-decoration: none !important;
    color: #000000;
  }

  .logo-wrapper {
    flex: 0 1 auto;
    margin: 0 auto;
    padding: 0 18px;
  }

  .header-logo-text {
    display: inline-block;
    white-space: nowrap;
  }

  .right-nav {
    text-align: right;
    white-space: nowrap;
  }

  .account {
    margin-right: 15px;
  }

  .burger-menu {
    cursor: pointer;
    display: none;
    position: relative;
    z-index: 997;
    flex: 0 0 auto;
  }

  .cross {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .header-wrapper {
      min-height: 56px;
      padding: 0 12px;
      justify-content: space-between;
    }

    .burger-menu {
      display: block;
      margin-right: 15px;
    }

    .header-menu {
      display: none;
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100dvh;
      background: #ffffff;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 996;
    }

    .header-menu.active {
      display: flex;
    }

    .header-menu .menu-item {
      margin: 0 0 24px 0 !important;
      text-align: center;
    }

    .header-menu .menu-item a {
      font-size: 24px !important;
      color: #000000 !important;
    }

    .account {
      display: none;
    }

    .account-mobile {
      display: inline-block;
    }

    .logo-wrapper {
      padding: 0 10px;
    }
  }

  @media screen and (min-width: 750px) {
    .account-mobile {
      display: none;
    }
  }
</style>

<div class="page-width">
  <div class="header-wrapper">

    <div class="burger-menu" aria-label="Menu" role="button" tabindex="0">
      <svg xmlns="http://www.w3.org/2000/svg" class="burger" width="45" height="41" viewBox="0 0 55 51" fill="none">
        <line x1="8" y1="20" x2="48" y2="20" stroke="currentColor" stroke-width="2"></line>
        <line x1="8" y1="28.6133" x2="48" y2="28.6133" stroke="currentColor" stroke-width="2"></line>
      </svg>

      <svg class="cross" xmlns="http://www.w3.org/2000/svg" width="45" height="41" viewBox="0 0 45 41" fill="none">
        <path d="M13 30.4902L31.4902 12" stroke="currentColor" stroke-width="1.65"></path>
        <path d="M13 12L31.4902 30.4902" stroke="currentColor" stroke-width="1.65"></path>
      </svg>
    </div>

    <nav class="header-menu" aria-label="Main navigation">
      {% if section.settings.menu != blank %}
        {% for link in section.settings.menu.links %}
          <div class="menu-item">
            <a href="{{ link.url }}" class="menu-link">{{ link.title }}</a>
          </div>
        {% endfor %}
      {% endif %}

      {% if shop.customer_accounts_enabled %}
        <div class="menu-item">
          <a class="account-mobile menu-link" href="{{ routes.account_url }}">Account</a>
        </div>
      {% endif %}
    </nav>

    <div class="logo-wrapper">
      <a href="{{ routes.root_url }}" class="header__heading-link">
        <span class="header-logo-text">VYBE</span>
      </a>
    </div>

    <div class="right-nav">
      {% if shop.customer_accounts_enabled %}
        <a class="account" href="{{ routes.account_url }}">Account</a>
      {% endif %}
      <a href="{{ routes.cart_url }}">Cart (<span id="CartCount">{{ cart.item_count }}</span>)</a>
    </div>

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var burgerMenu = document.querySelector('.burger-menu');
    var headerMenu = document.querySelector('.header-menu');
    var burgerIcon = document.querySelector('.burger');
    var crossIcon = document.querySelector('.cross');

    if (!burgerMenu || !headerMenu) return;

    function toggleMenu() {
      var isOpen = headerMenu.classList.toggle('active');

      burgerIcon.style.display = isOpen ? 'none' : 'block';
      crossIcon.style.display = isOpen ? 'block' : 'none';
      document.body.style.overflow = isOpen ? 'hidden' : '';
    }

    burgerMenu.addEventListener('click', toggleMenu);

    burgerMenu.addEventListener('keydown', function (event) {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        toggleMenu();
      }
    });

    headerMenu.querySelectorAll('a').forEach(function (link) {
      link.addEventListener('click', function () {
        headerMenu.classList.remove('active');
        burgerIcon.style.display = 'block';
        crossIcon.style.display = 'none';
        document.body.style.overflow = '';
      });
    });
  });
</script>

{% schema %}
{
  "name": "VYBE Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    }
  ]
}
{% endschema %}
