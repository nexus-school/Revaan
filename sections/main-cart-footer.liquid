<div class="cart-footer">
  <div class="cart-subtotal">
    <span>SUBTOTAL</span>
    <span>{{ cart.total_price | money }}</span>
  </div>
  <a href="/checkout" class="btn-checkout">CHECKOUT</a>
  <a href="/collections/all" class="btn-continue">CONTINUE SHOPPING</a>
</div>

<style>
  .cart-footer { max-width: 800px; margin: 0 auto; padding: 30px 20px 60px; }
  .cart-subtotal { display: flex; justify-content: space-between; font-size: 1.2rem; font-weight: 700; text-transform: uppercase; border-top: 2px solid #000; padding-top: 20px; margin-bottom: 20px; }
  .btn-checkout { display: block; background: #000; color: #fff; text-align: center; padding: 16px; font-weight: 900; letter-spacing: 0.15em; text-decoration: none; margin-bottom: 12px; }
  .btn-continue { display: block; text-align: center; font-size: 0.85rem; font-weight: 700; text-decoration: underline; color: #000; }
</style>

{% schema %}
{
  "name": "Cart Footer",
  "settings": []
}
{% endschema %}
