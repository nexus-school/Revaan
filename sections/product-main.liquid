{% comment %}
  ============================================
  MANUAL PRICE SETTINGS - EDIT THESE VALUES
  ============================================
{% endcomment %}
{% assign original_price = 3999 %}
{% assign sale_price = 1999 %}
{% comment %}
  ============================================
  END PRICE SETTINGS
  ============================================
{% endcomment %}

<style>
/* =========================================================
   EYEZY-STYLE PRODUCT CSS
   Selectors mapped to the class names used in this Liquid file
   ========================================================= */

.luxury-product-page,
.luxury-product-page * {
  box-sizing: border-box;
}

.luxury-product-page {
  width: 100%;
  max-width: 1600px;
  margin: 0 auto;
  padding: 0 20px;
  color: #000;
  background: #fff;
  font-family: var(--font-body-family, Helvetica, Arial, sans-serif);
}

/* DESKTOP 3-COLUMN PRODUCT LAYOUT */
.product-grid {
  display: grid;
  grid-template-columns: minmax(240px, 0.8fr) minmax(0, 1.8fr) minmax(240px, 0.8fr);
  gap: 32px;
  align-items: start;
  width: 100%;
}

/* LEFT COLUMN */
.product-info-left {
  padding-top: 20px;
  min-width: 0;
}

.breadcrumb {
  margin-bottom: 18px;
  font-size: 11px;
  line-height: 1.4;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #8b8b8b;
}

.breadcrumb a {
  color: inherit;
  text-decoration: none;
}

.breadcrumb a:hover {
  color: #000;
}

.product-title {
  margin: 0 0 12px;
  padding: 0;
  font-family: var(--font-heading-family, "Archivo Narrow", sans-serif);
  font-size: 30px;
  line-height: 1.05;
  font-style: var(--font-heading-style, normal);
  font-weight: var(--font-heading-weight, 700);
  text-transform: uppercase;
}

.product-price {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 10px;
  margin: 0 0 24px;
}

.price-sale {
  font-size: 16px;
  line-height: 1.3;
}

.price-compare {
  font-size: 15px;
  color: #777;
  text-decoration: line-through;
}

/* ACCORDIONS - maps the source accordion styles to your info-section markup */
.info-section {
  width: 100%;
  margin: 0;
  border-top: 1px solid #dedede;
}

.info-section:last-child {
  border-bottom: 1px solid #dedede;
}

.info-section-header {
  width: 100%;
  padding: 14px 10px 14px 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  cursor: pointer;
  user-select: none;
}

.info-section-title {
  margin: 0;
  padding: 0;
  font-family: var(--font-body-family, Helvetica, Arial, sans-serif);
  font-size: 14px;
  line-height: 1.3;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}

.info-section-toggle {
  flex: 0 0 auto;
  font-size: 18px;
  line-height: 1;
  font-weight: 300;
}

.info-section-content {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.info-section.active .info-section-content {
  max-height: 700px;
  padding-bottom: 16px;
}

.info-section-content > * {
  margin: 0;
  padding: 0 10px 8px 0;
}

.info-section-content p,
.info-section-content li {
  font-size: 14px;
  line-height: 1.55;
}

/* CENTER COLUMN - maps .figureImg / .product__item-img */
.product-image-column {
  position: relative;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.product-image-wrapper {
  position: relative;
  width: 100%;
  height: calc(100vh - 150px);
  min-height: 620px;
  overflow: hidden;
  background: #fff;
  touch-action: pan-y;
}

.product-image {
  position: absolute;
  top: 50%;
  left: 50%;
  width: auto;
  height: auto;
  max-width: 100%;
  max-height: 100%;
  transform: translate(-50%, -50%);
  object-fit: contain;
  user-select: none;
  -webkit-user-drag: none;
}

/* DESKTOP IMAGE ARROWS */
.image-nav-arrow {
  position: absolute;
  top: 50%;
  z-index: 3;
  width: 42px;
  height: 42px;
  padding: 0;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  background: rgba(255,255,255,0.72);
  color: #000;
  font-size: 26px;
  line-height: 1;
  cursor: pointer;
  opacity: 0.25;
  transition: opacity 0.2s ease, background 0.2s ease;
}

.product-image-wrapper:hover .image-nav-arrow {
  opacity: 1;
}

.image-nav-arrow:hover {
  background: rgba(255,255,255,0.95);
}

.image-nav-arrow.prev {
  left: 12px;
}

.image-nav-arrow.next {
  right: 12px;
}

/* Your dots replace the source mobile image-navigation/nav-dots */
.image-dots {
  display: none;
}

/* RIGHT COLUMN - maps .product-info__main / .option-values / .option-value */
.product-info-right {
  padding-top: 20px;
  min-width: 0;
}

.product-info-right form {
  width: 100%;
}

.size-section {
  width: 100%;
  margin: 0 0 22px;
}

.size-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 14px;
}

.size-label,
.size-chart-link {
  font-family: var(--font-body-family, Helvetica, Arial, sans-serif);
  font-size: 13px;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}

.size-chart-link {
  padding: 0;
  border: 0;
  background: none;
  color: #000;
  text-decoration: underline;
  text-underline-offset: 3px;
  cursor: pointer;
}

.size-options {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px 18px;
  width: 100%;
}

.size-option {
  min-width: 28px;
  padding: 4px 0;
  border: 0;
  border-bottom: 1px solid transparent;
  border-radius: 0;
  background: transparent;
  color: #000;
  font-family: var(--font-heading-family, "Archivo Narrow", sans-serif);
  font-size: 15px;
  font-weight: var(--font-heading-weight, 700);
  text-transform: uppercase;
  cursor: pointer;
}

.size-option:hover,
.size-option.selected {
  border-bottom-color: #000;
}

.size-option:disabled {
  opacity: 0.3;
  cursor: not-allowed;
  text-decoration: line-through;
}

/* OPTIONAL GIFT CARD ROW */
.gift-card-option {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 0 0 18px;
}

.gift-card-option input[type="checkbox"] {
  width: 15px;
  height: 15px;
  margin: 0;
}

.gift-card-option label {
  font-size: 13px;
  line-height: 1.3;
}

/* BUTTONS - maps .product-info__cart-btn */
.button-group {
  display: grid;
  grid-template-columns: 1fr;
  gap: 8px;
  width: 100%;
}

.btn {
  width: 100%;
  min-height: 48px;
  padding: 13px 16px;
  border-radius: 0;
  font-family: var(--font-heading-family, "Archivo Narrow", sans-serif);
  font-size: 15px;
  font-style: var(--font-heading-style, normal);
  font-weight: var(--font-heading-weight, 700);
  letter-spacing: 0;
  text-transform: uppercase;
  cursor: pointer;
  transition: background 0.2s ease, color 0.2s ease, opacity 0.2s ease;
}

.btn-add-to-cart {
  border: 1px solid #000;
  background: #000;
  color: #fff;
}

.btn-add-to-cart:hover {
  background: #222;
}

.btn-buy-now {
  border: 1px solid #000;
  background: #fff;
  color: #000;
}

.btn-buy-now:hover {
  background: #f5f5f5;
}

.btn:disabled {
  opacity: 0.35;
  cursor: not-allowed;
}

/* SIZE CHART MODAL */
.size-chart-modal {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 9999;
  padding: 20px;
  align-items: center;
  justify-content: center;
  background: rgba(0,0,0,0.65);
}

.size-chart-modal.active {
  display: flex;
}

.size-chart-modal-content {
  position: relative;
  width: min(600px, 100%);
  max-height: 90vh;
  overflow: auto;
  padding: 35px;
  background: #fff;
}

.size-chart-modal-close {
  position: absolute;
  top: 12px;
  right: 16px;
  font-size: 30px;
  line-height: 1;
  cursor: pointer;
}

.size-chart-unit-toggle {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 18px;
}

.size-chart-unit-button {
  flex: 1 1 0;
  padding: 10px 14px;
  border: 1px solid #000;
  background: #fff;
  color: #000;
  font-family: var(--font-body-family, Helvetica, Arial, sans-serif);
  font-size: 13px;
  font-weight: 400;
  line-height: 1.2;
  cursor: pointer;
  transition: background 0.2s ease, color 0.2s ease, font-weight 0.2s ease;
}

.size-chart-unit-button.active {
  background: #000;
  color: #fff;
  font-weight: 700;
}

.size-chart-image-wrapper {
  position: relative;
  margin-top: 20px;
}

.size-chart-image {
  display: block;
  width: 100%;
  height: auto;
  margin: 0;
  opacity: 1;
  transition: opacity 0.2s ease;
}

.size-chart-image.is-hidden {
  display: none;
  opacity: 0;
}

/* =========================================================
   MOBILE - mirrors the source product page behaviour
   ========================================================= */
@media screen and (max-width: 749px) {
  .luxury-product-page {
    padding: 0 15px;
  }

  .product-grid {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .product-image-column {
    order: 1;
    width: calc(100% + 30px);
    margin-left: -15px;
  }

  .product-info-left {
    order: 2;
    width: 100%;
    padding-top: 18px;
  }

  .product-info-right {
    order: 3;
    width: 100%;
    padding-top: 20px;
  }

  .breadcrumb {
    display: none;
  }

  .product-title {
    margin-bottom: 8px;
    font-size: 25px;
    line-height: 1.05;
  }

  .product-price {
    margin-bottom: 18px;
  }

  .product-image-wrapper {
    width: 100%;
    height: auto;
    min-height: 0;
    aspect-ratio: 1 / 1.22;
    background: #fff;
  }

  .product-image {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    object-fit: contain;
  }

  .image-nav-arrow {
    display: none;
  }

  .image-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    margin: 8px 0 18px;
  }

  .image-dot {
    width: 10px;
    height: 10px;
    padding: 0;
    border: 1px solid #000;
    border-radius: 50%;
    background: #fff;
    cursor: pointer;
  }

  .image-dot.active {
    background: #000;
  }

  .info-section-header {
    padding: 13px 0;
  }

  .info-section-title {
    font-size: 14px;
  }

  .size-options {
    gap: 8px 16px;
  }

  .button-group {
    gap: 8px;
  }
}

/* Small phones */
@media screen and (max-width: 420px) {
  .product-title {
    font-size: 23px;
  }

  .size-options {
    gap: 7px 13px;
  }

  .size-option {
    font-size: 14px;
  }
}
</style>

<div class="luxury-product-page">
  <div class="product-grid">
    <!-- LEFT COLUMN - INFO -->
    <div class="product-info-left">
      <!-- Breadcrumb -->
      <div class="breadcrumb">
        <a href="/">HOME</a> › 
        <a href="/collections/all">ALL PRODUCTS</a> › 
        <span>{{ product.title | upcase }}</span>
      </div>

      <!-- Product Title -->
      <h1 class="product-title">{{ product.title }}</h1>

      <!-- Price with Manual Comparison -->
      <div class="product-price">
        <span class="price-sale">{{ product.price | money }}</span>
        {% if product.compare_at_price > product.price %}
          <span class="price-compare">{{ product.compare_at_price | money }}</span>
        {% endif %}
      </div>

      <!-- Collapsible Sections -->
      <div class="info-section active">
        <div class="info-section-header" onclick="toggleSection(this)">
          <h3 class="info-section-title">Description</h3>
          <span class="info-section-toggle">−</span>
        </div>
        <div class="info-section-content">
          {{ product.description }}
        </div>
      </div>

      <div class="info-section">
        <div class="info-section-header" onclick="toggleSection(this)">
          <h3 class="info-section-title">Details</h3>
          <span class="info-section-toggle">+</span>
        </div>
        <div class="info-section-content">
          <p>TERRY COTTON / TERRY LYCRA</p>
          <p>WEIGHT - 240 GSM</p>
          <p>HIGH DENSITY SCREEN WITH 3d PUFF PRINT</p>
          <p>REVERSE WASH ONLY</p>
        </div>
      </div>

      <div class="info-section">
        <div class="info-section-header" onclick="toggleSection(this)">
          <h3 class="info-section-title">Shipping</h3>
          <span class="info-section-toggle">+</span>
        </div>
        <div class="info-section-content">
          <p>PACKED WITHIN 24 HOURS</p>
          <p>INTERNATIONAL DELIVERY</p>
          <p>DISPATCHES NEXT DAY</p>
        </div>
      </div>
    </div>

      <!-- CENTER COLUMN - IMAGE -->
      <div class="product-image-column">
        <div class="product-image-wrapper" id="image-wrapper">

          {% if product.featured_image %}
            <img 
              src="{{ product.featured_image | image_url: width: 1200 }}" 
              alt="{{ product.featured_image.alt | default: product.title | escape }}"
              class="product-image"
              id="main-product-image"
              width="{{ product.featured_image.width }}"
              height="{{ product.featured_image.height }}"
            >
          {% endif %}
              
          {% if product.images.size > 1 %}
            <div class="image-nav-arrow prev" onclick="navigateImage('prev')">‹</div>
            <div class="image-nav-arrow next" onclick="navigateImage('next')">›</div>
          {% endif %}

        </div>

      {% if product.images.size > 1 %}
      <div class="image-dots">
        {% for image in product.images %}
          <div class="image-dot {% if forloop.first %}active{% endif %}" 
               data-image-src="{{ image | img_url: 'large' }}"
               onclick="changeImage(this)"></div>
        {% endfor %}
      </div>
      {% endif %}
    </div>

    <!-- RIGHT COLUMN - FORM -->
    <div class="product-info-right">
      <form action="/cart/add" method="post" enctype="multipart/form-data">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="variant-id">

        <!-- Size Selector -->
        {% if product.variants.size > 1 %}
        <div class="size-section">
          <div class="size-header">
            <div class="size-label">Size</div>
            <button type="button" class="size-chart-link" onclick="document.getElementById('size-chart-modal').classList.add('active')">
              Size Chart - Innacurate right now
            </button>
          </div>
          
          <div class="size-options">
            {% for variant in product.variants %}
              <button 
                type="button" 
                class="size-option {% if variant == product.selected_or_first_available_variant %}selected{% endif %}" 
                data-variant-id="{{ variant.id }}"
                {% unless variant.available %}disabled{% endunless %}>
                {{ variant.title }}
              </button>
            {% endfor %}
          </div>
        </div>
        {% endif %}

        <!-- Gift Card Option -->
        <div class="gift-card-option">
          <input type="checkbox" id="gift-card" name="properties[Gift Card]" value="Yes">
          <label for="gift-card">Have a Gift Card?</label>
        </div>

        <!-- Buttons -->
        <div class="button-group">
          <button type="submit" class="btn btn-add-to-cart" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
            {% if product.selected_or_first_available_variant.available %}
              Add to Cart
            {% else %}
              Sold Out
            {% endif %}
          </button>
          <button type="button" class="btn btn-buy-now" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
            Buy Now
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Size Chart Modal -->
<div id="size-chart-modal" class="size-chart-modal">
  <div class="size-chart-modal-content">
    <span class="size-chart-modal-close" onclick="document.getElementById('size-chart-modal').classList.remove('active')">&times;</span>
    <h3 style="font-size: 18px; font-weight: 600; text-transform: uppercase; letter-spacing: 1.5px;">Size Chart</h3>

    {% if section.settings.cm_image != blank or section.settings.inches_image != blank %}
      <div class="size-chart-unit-toggle" role="group" aria-label="Size chart units">
        <button type="button" class="size-chart-unit-button active" data-size-chart-unit="cm" aria-pressed="true">Centimetres</button>
        <button type="button" class="size-chart-unit-button" data-size-chart-unit="inches" aria-pressed="false">Inches</button>
      </div>

      <div class="size-chart-image-wrapper">
        {% if section.settings.cm_image != blank %}
          <img
            src="{{ section.settings.cm_image | image_url: width: 800 }}"
            alt="{{ section.settings.cm_image.alt | default: 'Size chart in centimetres' | escape }}"
            class="size-chart-image"
            data-size-chart-image="cm"
            width="{{ section.settings.cm_image.width }}"
            height="{{ section.settings.cm_image.height }}"
          >
        {% endif %}

        {% if section.settings.inches_image != blank %}
          <img
            src="{{ section.settings.inches_image | image_url: width: 800 }}"
            alt="{{ section.settings.inches_image.alt | default: 'Size chart in inches' | escape }}"
            class="size-chart-image is-hidden"
            data-size-chart-image="inches"
            width="{{ section.settings.inches_image.width }}"
            height="{{ section.settings.inches_image.height }}"
          >
        {% endif %}
      </div>
    {% else %}
      <p style="margin-top: 20px;">Please upload Centimetres and Inches size chart images from the theme editor.</p>
    {% endif %}
  </div>
</div>

<script>
// Toggle collapsible sections
function toggleSection(header) {
  const section = header.parentElement;
  const toggle = header.querySelector('.info-section-toggle');
  
  section.classList.toggle('active');
  toggle.textContent = section.classList.contains('active') ? '−' : '+';
}

// Size selector
document.querySelectorAll('.size-option').forEach(button => {
  button.addEventListener('click', function() {
    if (this.disabled) return;
    
    document.querySelectorAll('.size-option').forEach(btn => btn.classList.remove('selected'));
    this.classList.add('selected');
    
    const variantId = this.getAttribute('data-variant-id');
    document.getElementById('variant-id').value = variantId;
  });
});

// Image Gallery Management
let currentImageIndex = 0;
const imageDots = document.querySelectorAll('.image-dot');
const totalImages = imageDots.length;

// Image switching by dot click
function changeImage(dot) {
  const imageSrc = dot.getAttribute('data-image-src');
  const mainImage = document.getElementById('main-product-image');
  
  mainImage.src = imageSrc;
  
  imageDots.forEach((d, index) => {
    if (d === dot) {
      currentImageIndex = index;
      d.classList.add('active');
    } else {
      d.classList.remove('active');
    }
  });
}

// Navigate images with arrows
function navigateImage(direction) {
  if (totalImages === 0) return;
  
  if (direction === 'prev') {
    currentImageIndex = (currentImageIndex - 1 + totalImages) % totalImages;
  } else {
    currentImageIndex = (currentImageIndex + 1) % totalImages;
  }
  
  const targetDot = imageDots[currentImageIndex];
  changeImage(targetDot);
}

// Touch Swipe Functionality
let touchStartX = 0;
let touchEndX = 0;

const imageWrapper = document.getElementById('image-wrapper');

if (imageWrapper && totalImages > 1) {
  imageWrapper.addEventListener('touchstart', function(e) {
    touchStartX = e.changedTouches[0].screenX;
  }, { passive: true });

  imageWrapper.addEventListener('touchend', function(e) {
    touchEndX = e.changedTouches[0].screenX;
    handleSwipe();
  }, { passive: true });
}

function handleSwipe() {
  const swipeThreshold = 50;
  const diff = touchStartX - touchEndX;
  
  if (Math.abs(diff) > swipeThreshold) {
    if (diff > 0) {
      navigateImage('next');
    } else {
      navigateImage('prev');
    }
  }
}

// Keyboard navigation
document.addEventListener('keydown', function(e) {
  if (totalImages > 1) {
    if (e.key === 'ArrowLeft') {
      navigateImage('prev');
    } else if (e.key === 'ArrowRight') {
      navigateImage('next');
    }
  }
});

// Close modal on outside click
const sizeChartModal = document.getElementById('size-chart-modal');
if (sizeChartModal) {
  sizeChartModal.addEventListener('click', function(e) {
    if (e.target === this) {
      this.classList.remove('active');
    }
  });
}

// Size chart centimetres / inches toggle
const sizeChartUnitButtons = document.querySelectorAll('[data-size-chart-unit]');
const sizeChartImages = document.querySelectorAll('[data-size-chart-image]');

function showSizeChartUnit(unit) {
  const requestedImage = document.querySelector(`[data-size-chart-image="${unit}"]`);
  const fallbackImage = document.querySelector('[data-size-chart-image="cm"]') || document.querySelector('[data-size-chart-image="inches"]');
  const imageToShow = requestedImage || fallbackImage;

  if (!imageToShow) return;

  const activeUnit = imageToShow.getAttribute('data-size-chart-image');

  sizeChartImages.forEach(image => {
    image.classList.toggle('is-hidden', image !== imageToShow);
  });

  sizeChartUnitButtons.forEach(button => {
    const isActive = button.getAttribute('data-size-chart-unit') === activeUnit;
    button.classList.toggle('active', isActive);
    button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
  });
}

sizeChartUnitButtons.forEach(button => {
  button.addEventListener('click', function() {
    showSizeChartUnit(this.getAttribute('data-size-chart-unit'));
  });
});

// Default to centimetres when the size chart loads.
showSizeChartUnit('cm');

// Buy Now functionality
const buyNowBtn = document.querySelector('.btn-buy-now');
if (buyNowBtn) {
  buyNowBtn.addEventListener('click', function() {
    if (!this.disabled) {
      const form = this.closest('form');
      const formData = new FormData(form);
      
      fetch('/cart/add.js', {
        method: 'POST',
        body: formData
      })
      .then(response => response.json())
      .then(data => {
        window.location.href = '/checkout';
      })
      .catch(error => {
        console.error('Error:', error);
      });
    }
  });
}
</script>

{% schema %}
{
  "name": "Luxury Product Page",
  "settings": [
    {
