<div id="cart-drawer" class="cart-drawer" aria-hidden="true">
  <div class="cart-drawer__overlay" onclick="closeCartDrawer()"></div>
  <div class="cart-drawer__panel">
    <div class="cart-drawer__header">
      <h2>YOUR CART</h2>
      <button onclick="closeCartDrawer()" class="cart-drawer__close">✕</button>
    </div>
    <div class="cart-drawer__body" id="cart-drawer-body">
      <!-- Loaded dynamically -->
    </div>
    <div class="cart-drawer__footer" id="cart-drawer-footer"></div>
  </div>
</div>

<style>
  .cart-drawer { position: fixed; inset: 0; z-index: 9999; pointer-events: none; }
  .cart-drawer[aria-hidden="false"] { pointer-events: all; }
  .cart-drawer__overlay { position: absolute; inset: 0; background: rgba(0,0,0,0.5); opacity: 0; transition: opacity 0.3s; }
  .cart-drawer[aria-hidden="false"] .cart-drawer__overlay { opacity: 1; }
  .cart-drawer__panel { position: absolute; top: 0; right: 0; width: 420px; max-width: 100vw; height: 100%; background: #fff; transform: translateX(100%); transition: transform 0.35s cubic-bezier(0.4,0,0.2,1); display: flex; flex-direction: column; }
  .cart-drawer[aria-hidden="false"] .cart-drawer__panel { transform: translateX(0); }
  .cart-drawer__header { display: flex; justify-content: space-between; align-items: center; padding: 24px; border-bottom: 2px solid #000; }
  .cart-drawer__header h2 { font-size: 1rem; font-weight: 900; letter-spacing: 0.15em; margin: 0; }
  .cart-drawer__close { background: none; border: none; font-size: 1.2rem; cursor: pointer; font-weight: 700; }
  .cart-drawer__body { flex: 1; overflow-y: auto; padding: 0 24px; }
  .cart-drawer__item { display: grid; grid-template-columns: 90px 1fr auto; gap: 16px; align-items: start; padding: 20px 0; border-bottom: 1px solid #e0e0e0; }
  .cart-drawer__item img { width: 90px; height: 90px; object-fit: cover; }
  .cart-drawer__title { font-size: 0.85rem; font-weight: 900; letter-spacing: 0.06em; text-transform: uppercase; margin: 0 0 4px; }
  .cart-drawer__variant { font-size: 0.75rem; color: #666; margin: 0 0 12px; text-transform: uppercase; }
  .cart-drawer__qty { display: flex; align-items: center; gap: 8px; }
  .cart-drawer__qty button { width: 28px; height: 28px; border: 1px solid #000; background: #fff; font-size: 1rem; cursor: pointer; font-weight: 700; }
  .cart-drawer__qty span { font-size: 0.85rem; font-weight: 700; min-width: 20px; text-align: center; }
  .cart-drawer__item-price { font-size: 0.9rem; font-weight: 900; white-space: nowrap; }
  .cart-drawer__remove { font-size: 0.65rem; font-weight: 700; letter-spacing: 0.1em; text-decoration: underline; cursor: pointer; background: none; border: none; display: block; margin-top: 8px; }
  .cart-drawer__footer { padding: 20px 24px 32px; border-top: 2px solid #000; }
  .cart-drawer__subtotal { display: flex; justify-content: space-between; font-size: 1rem; font-weight: 900; letter-spacing: 0.1em; margin-bottom: 8px; }
  .cart-drawer__note { font-size: 0.72rem; color: #888; margin: 0 0 16px; }
  .cart-drawer__checkout { display: block; background: #000; color: #fff; text-align: center; padding: 16px; font-size: 0.85rem; font-weight: 900; letter-spacing: 0.15em; text-decoration: none; margin-bottom: 10px; }
  .cart-drawer__empty { text-align: center; padding: 60px 0; }
  .cart-drawer__empty p { font-size: 0.9rem; font-weight: 700; letter-spacing: 0.1em; margin-bottom: 20px; }
  .cart-drawer__shop-btn { display: inline-block; background: #000; color: #fff; padding: 12px 28px; font-size: 0.8rem; font-weight: 900; letter-spacing: 0.12em; text-decoration: none; }
</style>

<script>
  function openCartDrawer() {
    document.getElementById('cart-drawer').setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    fetchCart();
  }

  function closeCartDrawer() {
    document.getElementById('cart-drawer').setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  function fetchCart() {
    fetch('/cart.js')
      .then(r => r.json())
      .then(cart => renderCart(cart));
  }

  function renderCart(cart) {
    const body = document.getElementById('cart-drawer-body');
    const footer = document.getElementById('cart-drawer-footer');

    if (cart.item_count === 0) {
      body.innerHTML = `<div class="cart-drawer__empty"><p>YOUR CART IS EMPTY</p><a href="/collections/all" class="cart-drawer__shop-btn">SHOP ALL</a></div>`;
      footer.innerHTML = '';
      return;
    }

    body.innerHTML = cart.items.map((item, i) => `
      <div class="cart-drawer__item">
        <img src="${item.image}" alt="${item.title}">
        <div>
          <p class="cart-drawer__title">${item.product_title}</p>
          ${item.variant_title && item.variant_title !== 'Default Title' ? `<p class="cart-drawer__variant">${item.variant_title}</p>` : ''}
          <div class="cart-drawer__qty">
            <button onclick="updateQty(${item.key}, ${item.quantity - 1})">−</button>
            <span>${item.quantity}</span>
            <button onclick="updateQty(${item.key}, ${item.quantity + 1})">+</button>
          </div>
          <button class="cart-drawer__remove" onclick="updateQty(${item.key}, 0)">REMOVE</button>
        </div>
        <span class="cart-drawer__item-price">${formatMoney(item.final_line_price)}</span>
      </div>
    `).join('');

    footer.innerHTML = `
      <div class="cart-drawer__subtotal"><span>SUBTOTAL</span><span>${formatMoney(cart.total_price)}</span></div>
      <p class="cart-drawer__note">Taxes and shipping at checkout</p>
      <a href="/checkout" class="cart-drawer__checkout">CHECKOUT</a>
    `;
  }

  function updateQty(key, qty) {
    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: key, quantity: qty })
    }).then(() => fetchCart());
  }

  function formatMoney(cents) {
    return '£' + (cents / 100).toFixed(2);
  }

  // Intercept all cart icon clicks
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('a[href="/cart"]').forEach(el => {
      el.addEventListener('click', e => {
        e.preventDefault();
        openCartDrawer();
      });
    });
  });

  // Listen for add-to-cart events to auto-open drawer
  document.addEventListener('cart:updated', openCartDrawer);
</script>
