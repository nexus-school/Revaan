{% doc %}
  @prompt
    Create a product catalogue block that automatically displays all products from a user-selected collection. It should show product images, titles, and prices in a responsive grid layout. The collection source should be configurable in the theme editor settings so the merchant can point it to any collection (e.g. "All"). The grid should update automatically when new products are added to the selected collection.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-catalogue-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: #000000;
  }

  .ai-catalogue-{{ ai_gen_id }}__heading {
    margin: 0 0 24px;
    color: #000000;
    font-family: {{ settings.type_header_font.family }}, sans-serif;
    font-size: 28px;
    line-height: 1.1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .ai-catalogue-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.desktop_columns }}, minmax(0, 1fr));
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-catalogue-{{ ai_gen_id }}__card {
    min-width: 0;
    color: #000000;
    text-decoration: none;
  }

  .ai-catalogue-{{ ai_gen_id }}__image-wrap,
  .ai-catalogue-{{ ai_gen_id }}__placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f2f2f2;
  }

  .ai-catalogue-{{ ai_gen_id }}__image-wrap img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-catalogue-{{ ai_gen_id }}__card:hover .ai-catalogue-{{ ai_gen_id }}__image-wrap img {
    opacity: 0.82;
  }

  .ai-catalogue-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    color: #777777;
  }

  .ai-catalogue-{{ ai_gen_id }}__info {
    display: block;
    padding-top: 12px;
  }

  .ai-catalogue-{{ ai_gen_id }}__title,
  .ai-catalogue-{{ ai_gen_id }}__price {
    display: block;
    font-family: {{ settings.type_body_font.family }}, sans-serif;
    font-size: 14px;
    line-height: 1.35;
  }

  .ai-catalogue-{{ ai_gen_id }}__title {
    margin-bottom: 4px;
    color: #000000;
  }

  .ai-catalogue-{{ ai_gen_id }}__price {
    color: #333333;
  }

  .ai-catalogue-{{ ai_gen_id }}__empty {
    padding: 24px;
    background: #f2f2f2;
    color: #333333;
    font-family: {{ settings.type_body_font.family }}, sans-serif;
    font-size: 14px;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-catalogue-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-catalogue-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat({{ block.settings.mobile_columns }}, minmax(0, 1fr));
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-catalogue-{{ ai_gen_id }}__heading {
      margin-bottom: 18px;
      font-size: 22px;
    }

    .ai-catalogue-{{ ai_gen_id }}__info {
      padding-top: 9px;
    }
  }
{% endstyle %}

<div class="ai-catalogue-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.show_heading and block.settings.collection != blank %}
    <h2 class="ai-catalogue-{{ ai_gen_id }}__heading">{{ block.settings.collection.title | escape }}</h2>
  {% endif %}

  {% if block.settings.collection != blank %}
    {% paginate block.settings.collection.products by 250 %}
      {% if block.settings.collection.products_count > 0 %}
        <div class="ai-catalogue-{{ ai_gen_id }}__grid">
          {% for product in block.settings.collection.products %}
            <a class="ai-catalogue-{{ ai_gen_id }}__card" href="{{ product.url }}">
              {% if product.featured_image %}
                <span class="ai-catalogue-{{ ai_gen_id }}__image-wrap">
                  <img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}" loading="lazy">
                </span>
              {% else %}
                <span class="ai-catalogue-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</span>
              {% endif %}
              <span class="ai-catalogue-{{ ai_gen_id }}__info">
                <span class="ai-catalogue-{{ ai_gen_id }}__title">{{ product.title | escape }}</span>
                <span class="ai-catalogue-{{ ai_gen_id }}__price">{{ product.price | money }}</span>
              </span>
            </a>
          {% endfor %}
        </div>
      {% else %}
        <div class="ai-catalogue-{{ ai_gen_id }}__empty">This collection has no products yet.</div>
      {% endif %}
    {% endpaginate %}
  {% else %}
    <div class="ai-catalogue-{{ ai_gen_id }}__empty">Select a collection to display its products.</div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Product catalogue",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "checkbox", "id": "show_heading", "label": "Show collection title", "default": true },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "select", "id": "desktop_columns", "label": "Columns on desktop", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "3" },
    { "type": "select", "id": "mobile_columns", "label": "Columns on mobile", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2" },
    { "type": "range", "id": "grid_gap", "label": "Grid gap", "min": 8, "max": 40, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "mobile_gap", "label": "Mobile gap", "min": 6, "max": 30, "step": 4, "unit": "px", "default": 10 }
  ],
  "presets": [{ "name": "Product catalogue" }],
  "tag": null,
  "class": "product-catalogue-block"
}
{% endschema %}